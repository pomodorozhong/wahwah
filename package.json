{
  "name": "wahwah",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "predev": "npm run --silent build:wasm",
    "dev": "vite",
    "build:tofu": "node scripts/tofu/build.mjs",
    "prebuild": "npm run --silent build:wasm",
    "build": "tsc --noEmit && vite build",
    "build:pages": "npm run build -- --mode pages",
    "pretypecheck": "npm run --silent build:wasm",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run --silent build:wasm",
    "test": "vitest run",
    "pretest:pages": "npm run --silent build:wasm",
    "test:pages": "node --test scripts/check-pages.mjs",
    "preview": "vite preview",
    "build:packages": "npm run build --workspaces --if-present",
    "pack:performance": "node scripts/pack-release.mjs performance"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@wahwah/performance": "*",
    "pink-trombone-mod": "^0.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
