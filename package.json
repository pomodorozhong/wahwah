{
  "name": "wahwah-repo",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:wasm": "npm run build:wasm --workspace wahwah",
    "dev": "npm run dev --workspace @wahwah/playground --",
    "build:tofu": "npm run build:tofu --workspace @wahwah/playground",
    "build": "npm run build --workspace @wahwah/playground",
    "build:pages": "npm run build:pages --workspace @wahwah/playground",
    "build:packages": "npm run build --workspace wahwah",
    "typecheck": "npm run typecheck --workspace @wahwah/playground",
    "test": "npm run test --workspaces --if-present",
    "test:pages": "npm run test:pages --workspace @wahwah/playground",
    "preview": "npm run preview --workspace @wahwah/playground --",
    "pack:wahwah": "node scripts/pack-release.mjs wahwah"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
