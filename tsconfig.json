{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "wahwah": ["./packages/wahwah/src/index.ts"],
      "wahwah/performance": ["./packages/wahwah/src/performance/index.ts"],
      "wahwah/mumble": ["./packages/wahwah/src/mumble/index.ts"]
    }
  },
  "include": ["src", "tests", "packages/wahwah/src", "packages/wahwah/tests"]
}
